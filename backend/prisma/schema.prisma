model Tournament {
  id                    String           @id @default(uuid())
  title                 String
  slug                  String           @unique
  description           String           @db.Text
  rules                 String           @db.Text
  type                  TournamentType
  mode                  TournamentMode
  status                TournamentStatus @default(Draft)
  difficulty            String           @default("Mixed")
  registrationOpensAt   DateTime         @map("registration_opens_at")
  registrationClosesAt  DateTime         @map("registration_closes_at")
  startsAt              DateTime         @map("starts_at")
  endsAt                DateTime         @map("ends_at")
  leaderboardFreezesAt  DateTime?        @map("leaderboard_freezes_at")
  leaderboardFrozenAt  DateTime?        @map("leaderboard_frozen_at")
  frozenLeaderboard    Json?            @map("frozen_leaderboard")
  resultsPublishedAt    DateTime?        @map("results_published_at")
  teamSizeMin           Int              @default(1) @map("team_size_min")
  teamSizeMax           Int              @default(1) @map("team_size_max")
  maxParticipants       Int?             @map("max_participants")
  allowedLanguages      String[]         @map("allowed_languages")
  theme                 String?
  requiredFeatures      String?          @db.Text @map("required_features")
  submissionChecklist   String?          @db.Text @map("submission_checklist")
  requireDeployment     Boolean          @default(false) @map("require_deployment")
  firstPlacePoints      Float            @default(100) @map("first_place_points")
  secondPlacePoints     Float            @default(70) @map("second_place_points")
  thirdPlacePoints      Float            @default(50) @map("third_place_points")
  topTenPercentPoints   Float            @default(25) @map("top_ten_percent_points")
  participationPoints   Float            @default(5) @map("participation_points")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  questions          TournamentQuestion[]
  registrations      TournamentRegistration[]
  teams              TournamentTeam[]
  dsaSubmissions     DsaTournamentSubmission[]
  projectSubmissions ProjectTournamentSubmission[]
  announcements      TournamentAnnouncement[]
  presenceSnapshots  PresenceSnapshot[]

  @@index([status, startsAt])
  @@index([type, status, startsAt])
  @@map("tournaments")
}

