  @@map("user_presence")
}

model PresenceSnapshot {
  id           String   @id @default(uuid())
  bucketAt     DateTime @map("bucket_at")
  onlineCount  Int      @map("online_count")
  tournamentId String?  @map("tournament_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([bucketAt, tournamentId])
  @@index([bucketAt(sort: Desc)])
  @@map("presence_snapshots")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model Achievement {
  id             String              @id @default(uuid())
  title          String              @unique
  category       AchievementCategory
  conditionType  String              @map("condition_type")
  conditionValue Int                 @map("condition_value")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt(sort: Desc)])
  @@map("user_achievements")
}

model BlogPost {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  title     String
  content   String
  isDraft   Boolean  @default(false) @map("is_draft")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt(sort: Desc)])
  @@index([isDraft, createdAt(sort: Desc)])
  @@map("blog_posts")
}

model Release {
  id             String   @id @default(uuid())
  version        String
  title          String
  summary        String
  releaseTag     String   @map("release_tag")
  status         String   @default("Released")
  changelogSpecs String[] @map("changelog_specs")
  releasedAt     DateTime @default(now()) @map("released_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([releasedAt(sort: Desc)])
  @@map("releases")
}
