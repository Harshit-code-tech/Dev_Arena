generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — enforced at the database level, not just application level
// ─────────────────────────────────────────────────────────────────────────────

enum Difficulty {
  Easy
  Medium
  Hard
}

enum FullstackType {
  Learning
  Building
}

enum FullstackCategory {
  Course_Progress
  Practical_Work
}

enum PracticeType {
  DSA_Revision
  Concept_Explanation
}

enum ProjectDomain {
  Fullstack
  App
  AI
  Other
}

enum ProjectStatus {
  In_Progress
  Completed
}

enum MilestoneStatus {
  Pending
  Completed
}

enum NotificationType {
  reminder
  summary
  challenge
  system
}

enum AchievementCategory {
  DSA
  Fullstack
  Project
  Consistency
}

enum ScoreCategory {
  DSA
  Fullstack
  Project
  Practice
  General
  Challenge
}

enum FriendRequestStatus {
  Pending
  Declined
}

enum EmailInviteStatus {
  Pending
  Accepted
  Expired
}

enum AuthOtpPurpose {
  Signup
  Login
}

enum UserRole {
  User
  Admin
  Judge
  Moderator
}

enum TournamentType {
  DSA
  Project
}

enum TournamentMode {
  Solo
  Team
  Both
}

enum TournamentStatus {
  Draft
  Published
  Registration_Open
  Live
  Judging
  Completed
  Cancelled
}

enum TournamentRegistrationStatus {
  Registered
  Matched
  Withdrawn
  Disqualified
  Completed
}

enum TournamentSubmissionStatus {
  Draft
  Submitted
  Queued
  Running
  Accepted
  Wrong_Answer
  Time_Limit_Exceeded
  Memory_Limit_Exceeded
  Runtime_Error
  Compilation_Error
  Under_Review
  Scored
  Disqualified
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  role         UserRole @default(User)

  // ── Profile ───────────────────────────────────────────────
  avatarUrl    String?  @map("avatar_url")
  githubUrl    String?  @map("github_url")
  linkedinUrl  String?  @map("linkedin_url")
  portfolioUrl String?  @map("portfolio_url")
  username           String  @unique
  usernameChosen     Boolean @default(true) @map("username_chosen")
  onboardingRequired Boolean @default(false) @map("onboarding_required")
  useInitials        Boolean @default(false) @map("use_initials")

  // ── Preferences ───────────────────────────────────────────
  activityReminders       Boolean @default(true)  @map("activity_reminders")
  privacyMode             Boolean @default(false) @map("privacy_mode")
  compactWorkspace        Boolean @default(false) @map("compact_workspace")
  friendRequestEmails     Boolean @default(true)  @map("friend_request_emails")
  loginOtpEmails          Boolean @default(true)  @map("login_otp_emails")
  streakReminderEmails    Boolean @default(true)  @map("streak_reminder_emails")
  challengeNotifications  Boolean @default(true)  @map("challenge_notifications")
  inAppNotifications      Boolean @default(true)  @map("in_app_notifications")

  // ── Verified identity changes ─────────────────────────────
  pendingName                  String?   @map("pending_name")
  pendingEmail                 String?   @map("pending_email")
  profileChangeOtp             String?   @map("profile_change_otp")
  profileChangeOtpExpiresAt    DateTime? @map("profile_change_otp_expires_at")

  // ── Auth ──────────────────────────────────────────────────
  firebaseUid            String?   @unique @map("firebase_uid")
  isEmailVerified        Boolean   @default(false) @map("is_email_verified")
  emailOtp               String?   @map("email_otp")
  emailOtpExpiresAt      DateTime? @map("email_otp_expires_at")
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  // ── Legal acceptance ─────────────────────────────────────
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsVersion    String?   @map("terms_version")
  privacyVersion  String?   @map("privacy_version")

  // ── Stats ──────────────────────────────────────────────────
  arenaScore         Float    @default(0) @map("arena_score")
  streak             Int      @default(0)
  activeDays         Int      @default(0) @map("active_days")
  seasonPoints       Float    @default(0) @map("season_points")
  seasonNumber       Int      @default(1) @map("season_number")
  rank               String   @default("Unranked")
  topTechStack       Json?    @map("top_tech_stack")
  topTechStackUpdatedAt DateTime? @map("top_tech_stack_updated_at")
  topTechStackProjectCount Int @default(0) @map("top_tech_stack_project_count")
  weeklyBonusClaimed Boolean  @default(false) @map("weekly_bonus_claimed")
  seasonBonusClaimed Boolean  @default(false) @map("season_bonus_claimed")
  seasonStartDate    DateTime @default(now()) @map("season_start_date")

  dsaLogs          DSALog[]
  fullstackLogs    FullstackLog[]
  projects         Project[]
  projectLogs      ProjectLog[]
  practiceLogs     PracticeLog[]
  weeklyScores     WeeklyScore[]
  challengeResults ChallengeResult[]
  activities       Activity[]
  notifications    Notification[]
  userAchievements UserAchievement[]
  blogPosts        BlogPost[]
  scoreEvents      ScoreEvent[]
  feedbackSubmissions FeedbackSubmission[]
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendshipsAsA         Friendship[]    @relation("FriendshipUserA")
  friendshipsAsB         Friendship[]    @relation("FriendshipUserB")
  emailInvites           EmailInvite[]
  realtimeEvents         RealtimeEvent[]
  authOtpChallenges      AuthOtpChallenge[]
  chatIdentityBackup     ChatIdentityBackup?
  chatTotpRecovery        ChatTotpRecovery?
  chatDevices            ChatDevice[]
  chatPasskeys            ChatPasskeyRecovery[]
  chatDeviceTransfers     ChatDeviceTransfer[]
  matchingPreference     PlayerMatchingPreference?
  matchFeedbackGiven     PlayerMatchFeedback[] @relation("MatchFeedbackGiven")
  matchFeedbackReceived  PlayerMatchFeedback[] @relation("MatchFeedbackReceived")

  // ── Player Hub ─────────────────────────────────────────────
  chatPublicKey          Json?                 @map("chat_public_key")
  chatKeyVersion         Int                   @default(1) @map("chat_key_version")
  blocksCreated          PlayerBlock[]         @relation("PlayerBlocker")
  blocksReceived         PlayerBlock[]         @relation("PlayerBlocked")
  reportsCreated         PlayerReport[]
  savedProjects          ProjectSave[]
  collaborationPosts     CollaborationPost[]
  collaborationApplications CollaborationApplication[]
  communityPosts         CommunityPost[]
  communityComments      CommunityComment[]
  communityReactions     CommunityReaction[]
  communitySaves         CommunitySave[]
  conversationsAsA       DirectConversation[]  @relation("DirectConversationUserA")
  conversationsAsB       DirectConversation[]  @relation("DirectConversationUserB")
  directMessages         DirectMessage[]
  githubConnection       GitHubConnection?
  githubInstallations    GitHubInstallationAccess[]
  githubRepositories     GitHubAuthorizedRepository[]

  // ── Tournaments and administration ─────────────────────────
  tournamentRegistrations       TournamentRegistration[]
  tournamentTeamMemberships     TournamentTeamMember[]
  dsaTournamentSubmissions      DsaTournamentSubmission[]
  projectTournamentSubmissions  ProjectTournamentSubmission[]
  tournamentAnnouncements       TournamentAnnouncement[] @relation("TournamentAnnouncementAuthor")
  adminAuditLogs                 AdminAuditLog[] @relation("AdminAuditActor")
  presence                       UserPresence?

  @@map("users")
}

model DSALog {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  problemName     String     @map("problem_name")
  url             String?
  solutionUrl     String?     @map("solution_url")
  difficulty      Difficulty
  timeTaken       Int        @map("time_taken") // in minutes
  timeComplexity  String?    @map("time_complexity")
  spaceComplexity String?    @map("space_complexity")
  notes           String?
  activityDate    DateTime   @default(now()) @map("activity_date")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at") // needed for 24-hour edit rule

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforce: one URL per user (prevents duplicate problem entries)
  // NULLs are exempt — PostgreSQL treats each NULL as distinct
  @@unique([userId, url])
  @@index([userId, createdAt(sort: Desc)])
  @@map("dsa_logs")
}

model FullstackLog {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  title       String
  category    FullstackCategory @default(Practical_Work)
  type        FullstackType
  description String?
  timeSpent   Int           @map("time_spent") // in minutes
  proofLink   String?       @map("proof_link")
  activityDate DateTime     @default(now()) @map("activity_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at") // needed for 24-hour edit rule

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("fullstack_logs")
}

model Project {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  title       String
  description String?
  domain      ProjectDomain
  status      ProjectStatus @default(In_Progress)
  startDate             DateTime      @map("start_date")
  completionAwardedAt   DateTime?     @map("completion_awarded_at")
  isShared              Boolean       @default(false) @map("is_shared")
  shareSlug             String?       @unique @map("share_slug")
  sharedAt              DateTime?     @map("shared_at")

  // ── Verified GitHub repository evidence ───────────────────────
  githubRepositoryUrl       String?   @map("github_repository_url")
  githubRepositoryNodeId    String?   @map("github_repository_node_id")
  githubOwnerId             String?   @map("github_owner_id")
  githubRepositoryId        String?   @map("github_repository_id")
  githubRepositoryOwner     String?   @map("github_repository_owner")
  githubRepositoryName      String?   @map("github_repository_name")
  githubRepositoryFullName  String?   @map("github_repository_full_name")
  githubRepositoryPrivate   Boolean?  @map("github_repository_private")
  githubVisibility          String?   @map("github_visibility")
  githubRepositoryDefaultBranch String? @map("github_repository_default_branch")
  githubInstallationId      String?   @map("github_installation_id")
  githubPermission          String?   @map("github_permission")
  githubRoleName            String?   @map("github_role_name")
  githubLanguages           Json?     @map("github_languages")
  githubLanguagesFetchedAt  DateTime? @map("github_languages_fetched_at")
  githubTechnologyStack     Json?     @map("github_technology_stack")
  githubTechnologyFetchedAt DateTime? @map("github_technology_fetched_at")
  githubTechnologyStatus    String?   @map("github_technology_status")
  githubLastPushedAt        DateTime? @map("github_last_pushed_at")
  githubVerifiedAt          DateTime? @map("github_verified_at")
  githubLastCheckedAt       DateTime? @map("github_last_checked_at")
  githubAccessStatus        String?   @map("github_access_status")
  githubLanguageBytes       Json?     @map("github_language_bytes")
  githubIsFork              Boolean?  @map("github_is_fork")
  githubParentFullName      String?   @map("github_parent_full_name")
  githubContributionStatus String?   @map("github_contribution_status")
  githubContributorCommits Int?      @map("github_contributor_commits")
  githubRepositoryCommits  Int?      @map("github_repository_commits")
  githubUserAdditions      Int?      @map("github_user_additions")
  githubUserDeletions      Int?      @map("github_user_deletions")
  githubContributionPercent Float?   @map("github_contribution_percent")
  githubContributionWeight Float?    @map("github_contribution_weight")
  githubContributionVerifiedAt DateTime? @map("github_contribution_verified_at")
  githubEligibleForTechStack Boolean @default(false) @map("github_eligible_for_tech_stack")
  githubEligibilityReason  String?   @map("github_eligibility_reason")
  githubVerificationVersion String?  @map("github_verification_version")
  githubRepositorySizeKb   Int?      @map("github_repository_size_kb")
  githubSourceBytes        Float?    @map("github_source_bytes")
  projectScore             Float     @default(0) @map("project_score")
  projectScoreUpdatedAt    DateTime? @map("project_score_updated_at")
  projectScoreVersion      String?   @map("project_score_version")

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       ProjectLog[]
  milestones Milestone[]
  savedBy    ProjectSave[]
  refreshJob GitHubProjectRefreshJob?

  @@index([userId, status])
  @@index([userId, githubEligibleForTechStack])
  @@index([isShared, sharedAt(sort: Desc)])
  @@unique([userId, githubRepositoryId])
  @@map("projects")
}

model GitHubConnection {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  githubUserId          String?  @map("github_user_id")
  githubLogin           String?  @map("github_login")
  accessTokenEncrypted  String?  @map("access_token_encrypted")
  refreshTokenEncrypted String?  @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  oauthStateHash        String?  @unique @map("oauth_state_hash")
  oauthStateExpiresAt   DateTime? @map("oauth_state_expires_at")
  installStateHash      String?   @unique @map("install_state_hash")
  installStateExpiresAt DateTime? @map("install_state_expires_at")
  connectedAt           DateTime? @map("connected_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}

model GitHubInstallationAccess {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  installationId      String   @map("installation_id")
  accountId           String?  @map("account_id")
  accountLogin        String?  @map("account_login")
  accountType         String?  @map("account_type")
  repositorySelection String?  @map("repository_selection")
  permissions         Json?
  events              Json?
  lastSyncedAt        DateTime @default(now()) @map("last_synced_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubAuthorizedRepository[]

  @@unique([userId, installationId])
  @@index([installationId])
  @@map("github_installation_access")
}

model GitHubAuthorizedRepository {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  installationAccessId String   @map("installation_access_id")
  repositoryId         String   @map("repository_id")
  nodeId               String?  @map("node_id")
  ownerId              String?  @map("owner_id")
  ownerLogin           String   @map("owner_login")
  name                 String
  fullName             String   @map("full_name")
  url                  String
  isPrivate            Boolean  @map("is_private")
  visibility           String?
  defaultBranch        String   @map("default_branch")
  archived             Boolean  @default(false)
  disabled             Boolean  @default(false)
  permission           String
  roleName             String?  @map("role_name")
  pushedAt             DateTime? @map("pushed_at")
  lastSyncedAt         DateTime @default(now()) @map("last_synced_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation GitHubInstallationAccess @relation(fields: [installationAccessId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([installationAccessId, fullName])
  @@index([userId, fullName])
  @@map("github_authorized_repositories")
}

model ProjectLog {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  description String
  timeSpent   Int      @map("time_spent") // in minutes
  proofLink   String?  @map("proof_link")
  activityDate DateTime @default(now()) @map("activity_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at") // needed for 24-hour edit rule

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_logs")
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String          @map("project_id")
  title       String
  description String?
  status              MilestoneStatus @default(Pending)
  completionAwardedAt DateTime?       @map("completion_awarded_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("milestones")
}

model PracticeLog {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  title        String       @default("Practice session")
  type         PracticeType
  notes        String?
  timeSpent    Int          @default(0) @map("time_spent")
  proofLink    String?      @map("proof_link")
  activityDate DateTime     @default(now()) @map("activity_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at") // needed for 24-hour edit rule

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("practice_logs")
}

model ScoreEvent {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  category   ScoreCategory
  sourceType String        @map("source_type")
  sourceId   String        @map("source_id")
  label      String
  points     Float
  occurredAt DateTime      @map("occurred_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, category, occurredAt(sort: Desc)])
  @@map("score_events")
}

model WeeklyScore {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  weekStart       DateTime @map("week_start") @db.Date // Monday 00:00 IST
  dsaPoints       Float    @default(0) @map("dsa_points")
  fullstackPoints Float    @default(0) @map("fullstack_points")
  projectPoints   Float    @default(0) @map("project_points")
  practicePoints  Float    @default(0) @map("practice_points")
  generalPoints   Float    @default(0) @map("general_points")
  challengePoints Float    @default(0) @map("challenge_points")
  totalScore      Float    @default(0) @map("total_score")
  // Denormalized for fast leaderboard tie-breaking (avoids COUNT join on activity table)
  activeDays      Int      @default(0) @map("active_days")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  // Index: leaderboard queries by week, sorted by score then active days
  @@index([weekStart, totalScore(sort: Desc), activeDays(sort: Desc)])
  @@map("weekly_scores")
}

model ChallengeResult {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  weekStart      DateTime @map("week_start") @db.Date
  score          Int      @default(0)
  problemsSolved Int      @default(0) @map("problems_solved")
  completionTime Int?     @map("completion_time") // in minutes
  rank           Int?
  submissionLink String?  @map("submission_link") // GitHub link or upload proof

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart, score(sort: Desc)])
  @@map("challenge_results")
}

model Activity {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  date     DateTime @db.Date // date only — no time component
  isActive Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  // Index: heatmap queries a user's activity over a date range
  @@index([userId, date(sort: Desc)])
  @@map("activity")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  message    String
  type       NotificationType
  isRead     Boolean          @default(false) @map("is_read")
  link       String?          // redirect URL when notification is clicked
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index: notification bell always loads unread first, newest first
  @@index([userId, isRead, createdAt(sort: Desc)])
  // Action notifications can be removed automatically when their source is resolved.
  @@index([userId, entityType, entityId])
  @@map("notifications")
}


model RealtimeEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id")
  type       String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([createdAt])
  @@map("realtime_events")
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String              @map("sender_id")
  receiverId String              @map("receiver_id")
  status     FriendRequestStatus @default(Pending)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt(sort: Desc)])
  @@index([senderId, status, createdAt(sort: Desc)])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String   @map("user_a_id")
  userBId   String   @map("user_b_id")
  createdAt DateTime @default(now()) @map("created_at")

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, createdAt(sort: Desc)])
  @@index([userBId, createdAt(sort: Desc)])
  @@map("friendships")
}

model AuthOtpChallenge {
  id                  String         @id @default(uuid())
  purpose             AuthOtpPurpose
  email               String
  userId              String?        @map("user_id")
  pendingName         String?        @map("pending_name")
  pendingPasswordHash String?        @map("pending_password_hash")
  otpHash             String         @map("otp_hash")
  expiresAt           DateTime       @map("expires_at")
  resendAvailableAt   DateTime       @map("resend_available_at")
  attempts            Int            @default(0)
  maxAttempts         Int            @default(5) @map("max_attempts")
  rememberSession     Boolean        @default(false) @map("remember_session")
  consumedAt          DateTime?      @map("consumed_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@map("auth_otp_challenges")
}

model ChatIdentityBackup {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  publicKey           Json     @map("public_key")
  encryptedPrivateKey String   @db.Text @map("encrypted_private_key")
  iv                  String
  salt                String
  kdf                 String   @default("PBKDF2-SHA256")
  kdfIterations       Int      @default(310000) @map("kdf_iterations")
  keyVersion          Int      @default(1) @map("key_version")
  backupVersion       Int      @default(1) @map("backup_version")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

