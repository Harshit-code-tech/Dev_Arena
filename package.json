{
  "name": "devarena",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @devarena/frontend",
    "dev:backend": "npm run dev --workspace @devarena/backend",
    "build:frontend": "npm run build --workspace @devarena/frontend",
    "build:backend": "npm run build --workspace @devarena/backend",
    "build": "npm run build:frontend && npm run build:backend",
    "db:check": "npm run db:check --workspace @devarena/backend",
    "db:seed": "npm run db:seed --workspace @devarena/backend",
    "db:migrate": "npm run db:migrate --workspace @devarena/backend",
    "db:generate": "npm run db:generate --workspace @devarena/backend",
    "db:studio": "npm run db:studio --workspace @devarena/backend",
    "lint": "eslint .",
    "scores:rebuild": "npm run scores:rebuild --workspace @devarena/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.1"
  }
}
